#!/bin/sh
set -eu

app=@APP@
version=@VERSION@
target_system=@SYSTEM@
target_arch=@ARCH@
target_libc=@LIBC@

die() { printf 'Error: %s\n' "$*" >&2; exit 1; }

usage() {
    printf '%s %s offline installer\n' "$app" "$version"
    printf '%s\n' 'Usage: sh install.sh [--prefix DIR] [--check] [--force]'
    printf '%s\n' '  --prefix DIR  Install bin/ and share/ below DIR.'
    printf '%s\n' '  --check       Verify platform and files without installing.'
    printf '%s\n' '  --force       Replace existing files.'
}

if [ "$app" = bun ]; then
    prefix=${BUN_INSTALL:-${HOME:?HOME is required}/.bun}
else
    prefix=${HOME:?HOME is required}/.local
fi
check_only=0
force=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --prefix)
            [ "$#" -ge 2 ] || die '--prefix needs a directory'
            prefix=$2
            shift 2
            ;;
        --prefix=*) prefix=${1#*=}; shift ;;
        --check) check_only=1; shift ;;
        --force) force=1; shift ;;
        --help|-h) usage; exit 0 ;;
        *) die "Unknown argument: $1" ;;
    esac
done
case "$prefix" in /*) ;; *) die '--prefix must be an absolute path' ;; esac
[ "$prefix" != / ] || die 'Choose a prefix other than /'

root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
system=$(uname -s)
case "$system" in Linux) system=linux ;; Darwin) system=darwin ;; *) die "Unsupported OS: $system" ;; esac
arch=$(uname -m)
case "$arch" in x86_64|amd64) arch=x86_64 ;; aarch64|arm64) arch=aarch64 ;; *) die "Unsupported CPU: $arch" ;; esac
[ "$system" = "$target_system" ] || die "OS mismatch: bundle=$target_system, machine=$system"
[ "$arch" = "$target_arch" ] || die "CPU mismatch: bundle=$target_arch, machine=$arch"

if [ "$app" = bun ] && [ "$system" = linux ] && [ "$target_libc" != musl ]; then
    if [ -f /etc/alpine-release ] || (ldd --version 2>&1 || true) | grep -qi musl; then
        die 'This Bun bundle requires glibc. Build again with a -musl target.'
    fi
fi

printf 'Verifying %s %s (%s/%s)...\n' "$app" "$version" "$system" "$arch"
if command -v sha256sum >/dev/null 2>&1; then
    (cd "$root" && sha256sum -c SHA256SUMS) || die 'Checksum verification failed'
elif command -v shasum >/dev/null 2>&1; then
    (cd "$root" && shasum -a 256 -c SHA256SUMS) || die 'Checksum verification failed'
else
    die 'sha256sum or shasum is required; copy this utility from a compatible machine.'
fi

if [ "$check_only" -eq 1 ]; then
    printf '%s\n' 'Checks passed. No files installed.'
    exit 0
fi

# Check every destination before copying any files.
while IFS= read -r relative; do
    [ -n "$relative" ] || continue
    destination=$prefix/$relative
    [ ! -d "$destination" ] || die "Destination is a directory: $destination"
    if [ -e "$destination" ] || [ -L "$destination" ]; then
        [ "$force" -eq 1 ] || die "File already exists (use --force): $destination"
    fi
done <<'OFFPACK_FILES'
@FILES@
OFFPACK_FILES
while read -r relative link_target; do
    [ -n "$relative" ] || continue
    destination=$prefix/$relative
    [ ! -d "$destination" ] || die "Destination is a directory: $destination"
    if [ -e "$destination" ] || [ -L "$destination" ]; then
        [ "$force" -eq 1 ] || die "File already exists (use --force): $destination"
    fi
done <<'OFFPACK_LINKS'
@LINKS@
OFFPACK_LINKS

staged_file=
trap '[ -z "$staged_file" ] || rm -f -- "$staged_file"' 0
trap 'exit 130' 1 2 15
while IFS= read -r relative; do
    [ -n "$relative" ] || continue
    destination=$prefix/$relative
    mkdir -p -- "$(dirname -- "$destination")"
    staged_file=$(mktemp "${destination}.offpack.XXXXXXXX")
    cp -- "$root/payload/$relative" "$staged_file"
    case "$relative" in bin/*) chmod 755 "$staged_file" ;; *) chmod 644 "$staged_file" ;; esac
    mv -f -- "$staged_file" "$destination"
    staged_file=
done <<'OFFPACK_FILES'
@FILES@
OFFPACK_FILES
while read -r relative link_target; do
    [ -n "$relative" ] || continue
    destination=$prefix/$relative
    staged_file=$(mktemp "${destination}.offpack.XXXXXXXX")
    rm -f -- "$staged_file"
    ln -s -- "$link_target" "$staged_file"
    mv -f -- "$staged_file" "$destination"
    staged_file=
done <<'OFFPACK_LINKS'
@LINKS@
OFFPACK_LINKS

printf '\nInstalled %s %s to %s\n' "$app" "$version" "$prefix"
printf 'Add this directory to PATH: %s/bin\n' "$prefix"
if [ "$app" = zoxide ]; then
    printf '%s\n' 'Enable shell integration in your shell config:'
    printf '%s\n' '  Bash: eval "$(zoxide init bash)"'
    printf '%s\n' '  Zsh:  eval "$(zoxide init zsh)"'
    printf '%s\n' '  Fish: zoxide init fish | source'
fi
