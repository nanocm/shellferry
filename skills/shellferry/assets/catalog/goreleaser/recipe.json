{
  "schema": 1,
  "name": "goreleaser",
  "version": "2.20.0",
  "kind": "converted-script",
  "target": "linux-x86_64",
  "shell": "sh",
  "entrypoint": "upstream/install.sh",
  "scripts": [
    {
      "path": "upstream/install.sh",
      "url": "https://raw.githubusercontent.com/goreleaser/goreleaser/2c336825258ec3d4a690d5a0ed55b536b8e88785/www/static/run",
      "sha256": "85e64ae3bab7052ef7917f23084fb8b22526328801864686e86fa1b6a2a7852d",
      "patches": [
        {
          "old": "LATEST=\"$(curl -sf https://goreleaser.com/static/latest)\"",
          "new": "LATEST='v2.20.0'",
          "count": 1
        },
        {
          "old": "curl -sfLO \"$RELEASES_URL/download/$VERSION/$TAR_FILE\"",
          "new": "offline_fetch \"$RELEASES_URL/download/$VERSION/$TAR_FILE\" \"$TAR_FILE\"",
          "count": 1
        },
        {
          "old": "curl -sfLO \"$RELEASES_URL/download/$VERSION/checksums.txt\"",
          "new": "offline_fetch \"$RELEASES_URL/download/$VERSION/checksums.txt\" checksums.txt",
          "count": 1
        },
        {
          "old": "\"$TMP_DIR/goreleaser\" \"$@\"",
          "new": "mkdir -p \"$OFFLINE_PREFIX/bin\"\ninstall \"$TMP_DIR/goreleaser\" \"$OFFLINE_PREFIX/bin/goreleaser\"\n\"$OFFLINE_PREFIX/bin/goreleaser\" \"$@\"",
          "count": 1
        }
      ]
    }
  ],
  "resources": [
    {
      "url": "https://github.com/goreleaser/goreleaser/releases/download/v2.20.0/goreleaser_Linux_x86_64.tar.gz",
      "path": "resources/goreleaser_Linux_x86_64.tar.gz",
      "sha256": "d2483159e6007f814132cb56635ad30a70013dbeb813d6033a7e01adf6ae108c",
      "checksum_source": "GitHub release asset digest"
    },
    {
      "url": "https://github.com/goreleaser/goreleaser/releases/download/v2.20.0/checksums.txt",
      "path": "resources/checksums.txt",
      "sha256": "1788ef531cb7bdb46756637812a03cd9db1d5bf7ea855d2e478170504c1606ec",
      "checksum_source": "GitHub release asset digest"
    }
  ],
  "env": {
    "VERSION": "v2.20.0"
  },
  "args": [
    "--version"
  ],
  "requires": [
    "sh",
    "tar",
    "gzip",
    "sha256sum",
    "install"
  ],
  "smoke": [
    [
      "{prefix}/bin/goreleaser",
      "--version"
    ],
    [
      "sh",
      "-ec",
      "d=$(mktemp -d); cd \"$d\"; \"$OFFLINE_PREFIX/bin/goreleaser\" init; test -s .goreleaser.yaml; grep -q builds .goreleaser.yaml"
    ]
  ],
  "notes": [
    "Converts the official upstream installer; upstream source is fetched at a fixed commit rather than vendored.",
    "The official www/static/run is a download-verify-run launcher. This adaptation additionally retains the verified binary in prefix/bin before executing the requested --version command. Official optional cosign verification remains conditional on cosign availability; the test image does not include cosign."
  ],
  "validation_scope": {
    "userspace": "Ubuntu 22.04 prepared image",
    "network": "none",
    "runtime_scope": "CLI installation and local operation; no remote service, cluster or deployment is claimed."
  }
}
