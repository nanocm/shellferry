{
  "schema": 1,
  "name": "rclone",
  "version": "1.76.0",
  "target": "linux-x86_64",
  "shell": "bash",
  "entrypoint": "upstream/run.sh",
  "scripts": [
    {
      "path": "upstream/install.sh",
      "url": "https://raw.githubusercontent.com/rclone/rclone/master/docs/content/install.sh",
      "source": "sources/rclone.sh",
      "patches": [
        {
          "old": "current_version=$(curl -fsS https://downloads.rclone.org/version.txt)",
          "new": "current_version='rclone v1.76.0'",
          "count": 1
        },
        {
          "old": "curl -OfsS \"$download_link\"",
          "new": "offline_fetch \"$download_link\" \"$rclone_zip\"",
          "count": 1
        },
        {
          "old": "chown root:root /usr/bin/rclone.new",
          "new": ": # user-prefix installation keeps current ownership",
          "count": 1
        },
        {
          "old": "/usr/bin/rclone",
          "new": "\"${OFFLINE_PREFIX}/bin/rclone\"",
          "count": 8
        },
        {
          "old": "/usr/local/share/man/man1",
          "new": "\"${OFFLINE_PREFIX}/share/man/man1\"",
          "count": 3
        }
      ],
      "sha256": "b0559bafefe496f29b8a3de47d5779d708ed8b6092d2a5cf7631b8788dac31c2"
    },
    {
      "path": "upstream/run.sh",
      "source": "sources/rclone-wrapper.sh",
      "patches": [],
      "sha256": "db7c9d531ed9cd99ffe9d365edbb102ea7c443d38eaef7ceaea5ddaf232f226e"
    }
  ],
  "resources": [
    {
      "url": "https://github.com/rclone/rclone/releases/download/v1.76.0/rclone-v1.76.0-linux-amd64.zip",
      "path": "resources/rclone-v1.76.0-linux-amd64.zip",
      "aliases": [
        "https://downloads.rclone.org/rclone-current-linux-amd64.zip"
      ],
      "sha256": "b00f00b3266c3764413afe599d3ec316f6f43b3e0ea8a0bc1d186d2133e46df7",
      "checksum_source": "locally-pinned after HTTPS download; not an independently verified upstream checksum"
    }
  ],
  "env": {
    "OFFLINE_PREFIX": "{prefix}"
  },
  "args": [],
  "requires": [
    "bash",
    "unzip"
  ],
  "smoke": [
    [
      "{prefix}/bin/rclone",
      "version"
    ],
    [
      "sh",
      "-ec",
      "printf 'offline rclone transfer\\n' > /tmp/rclone-source.txt; \"${OFFLINE_PREFIX}/bin/rclone\" copyto /tmp/rclone-source.txt /tmp/rclone-dest.txt; cmp /tmp/rclone-source.txt /tmp/rclone-dest.txt"
    ]
  ],
  "notes": [
    "Converts official rclone install.sh source from upstream GitHub (rclone.org endpoint timed out). Pins release v1.76.0. Changes system /usr/bin installation to explicit user prefix; preserves original extraction and platform selection. No remote/storage credentials required for tests.",
    "Wrapper accepts upstream already-current exit code 3 only after checking installed binary version."
  ]
}
