{
  "schema": 1,
  "name": "bpkg",
  "version": "1.1.4",
  "target": "linux-x86_64",
  "shell": "bash",
  "entrypoint": "upstream/wrapper.sh",
  "scripts": [
    {
      "path": "upstream/install.sh",
      "url": "https://raw.githubusercontent.com/bpkg/bpkg/c7f5a467ec53e61d2344f5d1ab5766949c3bffdf/setup.sh",
      "sha256": "77da7ff460c721749b8493f60ba6ec4c967f1109a28dc53a2962a6e6f7d6cc15",
      "patches": [
        {
          "old": "git clone --depth=1 --branch \"$BRANCH\" \"$REMOTE\" \"$DEST\"",
          "new": "offline_bpkg_checkout \"$DEST\"",
          "count": 1
        }
      ],
      "checksum_source": "locally-pinned upstream script at fixed commit"
    },
    {
      "path": "upstream/wrapper.sh",
      "source": "sources/offline-wrapper.sh",
      "sha256": "3d3b80e252cb7cfeaf7df8f5d13d7b24986baf0a1813910c647b26b1770fd13e",
      "patches": []
    }
  ],
  "resources": [
    {
      "url": "https://codeload.github.com/bpkg/bpkg/tar.gz/c7f5a467ec53e61d2344f5d1ab5766949c3bffdf",
      "path": "resources/bpkg-source.tar.gz",
      "sha256": "3b82d9433200ef024512418dd2697a5ed3c4e7340b4b3e6d151fa25b5cb7f688",
      "checksum_source": "locally-computed-pin from official HTTPS release; not independently authenticated publisher checksum"
    }
  ],
  "args": [],
  "env": {
    "PREFIX": "{prefix}"
  },
  "requires": [
    "bash",
    "tar",
    "gzip",
    "git",
    "sha256sum"
  ],
  "smoke": [
    [
      "sh",
      "-ec",
      "export PATH=\"$OFFLINE_PREFIX/bin:$PATH\"; bpkg --version"
    ],
    [
      "sh",
      "-ec",
      "export PATH=\"$OFFLINE_PREFIX/bin:$PATH\"; printf '{\"name\":\"offline-demo\",\"version\":\"1.0.0\"}\\n' | bpkg json | grep -q offline-demo"
    ]
  ],
  "notes": [
    "Replaces only official setup git transport with the commit-pinned source archive. Preserves make_install and overwrite behavior.",
    "Upstream installer is fetched at build time from a pinned commit. No upstream script snapshot is vendored in the skill."
  ],
  "validation_scope": {
    "target": "Ubuntu 22.04 x86_64 glibc ordinary user",
    "network": "none"
  }
}
