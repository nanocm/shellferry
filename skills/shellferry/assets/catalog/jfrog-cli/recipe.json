          "new": "set -- \"$OFFLINE_PREFIX/bin\"",
          "count": 1
        },
        {
          "old": "mv $FILE_NAME \"$1\"",
          "new": "mv \"$FILE_NAME\" \"$1\"",
          "count": 2
