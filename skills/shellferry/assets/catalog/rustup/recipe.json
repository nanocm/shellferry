{
  "schema": 1,
  "name": "rustup",
  "version": "1.29.3-rust1.90.0",
  "target": "linux-x86_64",
  "shell": "sh",
  "entrypoint": "upstream/install.sh",
  "scripts": [
    {
      "path": "upstream/install.sh",
      "url": "https://sh.rustup.rs",
      "source": "sources/rustup.sh",
      "patches": [
        {
          "old": "    downloader --check",
          "new": "    need_cmd cp # offline_fetch supplies rustup-init",
          "count": 1
        },
        {
          "old": "ensure downloader \"$_url\" \"$_file\" \"$_arch\"",
          "new": "ensure offline_fetch \"$_url\" \"$_file\"",
          "count": 1
        }
      ],
      "sha256": "d890e2fef6fa991b19cde2e608199bc1dca4e37f41f884edf8849ff693048de6"
    }
  ],
  "resources": [
    {
      "url": "https://static.rust-lang.org/rustup/archive/1.29.3/x86_64-unknown-linux-gnu/rustup-init",
      "path": "resources/rustup-init-1.29.3",
      "sha256": "b1c8cb14e30889e7e2999e6b69e62d9e9b9ffc0f4df8180564d306d9680e6c55",
      "checksum_source": "locally-pinned after HTTPS download; not an independently verified upstream checksum"
    },
    {
      "url": "https://static.rust-lang.org/dist/channel-rust-1.90.0.toml",
      "path": "resources/rust-dist/dist/channel-rust-1.90.0.toml",
      "sha256": "489c19f20d331765ab2835661eb546de90f6446a107a8db83045e7371e45cae2",
      "checksum_source": "locally-pinned after HTTPS download; not an independently verified upstream checksum"
    },
    {
      "url": "https://static.rust-lang.org/dist/channel-rust-1.90.0.toml.sha256",
      "path": "resources/rust-dist/dist/channel-rust-1.90.0.toml.sha256",
      "sha256": "4c983e6e023c961b0b0afee201c79eafad874819cfc8df82d58ebae6c15592a9",
      "checksum_source": "locally-pinned after HTTPS download; not an independently verified upstream checksum"
    },
    {
      "url": "https://static.rust-lang.org/dist/2025-09-18/rustc-1.90.0-x86_64-unknown-linux-gnu.tar.xz",
      "path": "resources/rust-dist/dist/2025-09-18/rustc-1.90.0-x86_64-unknown-linux-gnu.tar.xz",
      "sha256": "48c2a42de9e92fcae8c24568f5fe40d5734696a6f80e83cc6d46eef1a78f13c9",
      "checksum_source": "official-rust-channel-manifest"
    },
    {
      "url": "https://static.rust-lang.org/dist/2025-09-18/cargo-1.90.0-x86_64-unknown-linux-gnu.tar.xz",
      "path": "resources/rust-dist/dist/2025-09-18/cargo-1.90.0-x86_64-unknown-linux-gnu.tar.xz",
      "sha256": "9853db03d68578a30972e2755c89c66aec035fec641cf8f3a7117c81eec2578d",
      "checksum_source": "official-rust-channel-manifest"
    },
    {
      "url": "https://static.rust-lang.org/dist/2025-09-18/rust-std-1.90.0-x86_64-unknown-linux-gnu.tar.xz",
      "path": "resources/rust-dist/dist/2025-09-18/rust-std-1.90.0-x86_64-unknown-linux-gnu.tar.xz",
      "sha256": "663f4ab7945b392d5e5294dec1b050a66820a20e86f084ec37eeb0f2f7ff5569",
      "checksum_source": "official-rust-channel-manifest"
    }
  ],
  "env": {
    "RUSTUP_VERSION": "1.29.3",
    "RUSTUP_HOME": "{prefix}/rustup",
    "CARGO_HOME": "{prefix}/cargo",
    "RUSTUP_DIST_SERVER": "file://{bundle}/resources/rust-dist",
    "RUSTUP_INIT_SKIP_PATH_CHECK": "yes"
  },
  "args": [
    "-y",
    "--profile",
    "minimal",
    "--default-host",
    "x86_64-unknown-linux-gnu",
    "--default-toolchain",
    "1.90.0",
    "--no-modify-path"
  ],
  "requires": [
    "sh"
  ],
  "smoke": [
    [
      "{prefix}/cargo/bin/rustc",
      "--version"
    ],
    [
      "{prefix}/cargo/bin/cargo",
      "--version"
    ],
    [
      "sh",
      "-c",
      "printf 'pub fn answer() -> u32 { 42 }\\n' > /tmp/offline-rust.rs; \"${OFFLINE_PREFIX}/cargo/bin/rustc\" --crate-type=lib --emit=metadata /tmp/offline-rust.rs -o /tmp/offline-rust.rmeta; test -s /tmp/offline-rust.rmeta"
    ]
  ],
  "notes": [
    "Converts official rustup shell bootstrap and includes actual minimal Rust toolchain rustc/cargo/rust-std 1.90.0. rustup-init consumes a local file:// distribution tree. Full arbitrary Cargo dependency builds and native linking tools require additional dependencies; smoke compiles Rust metadata without a linker."
  ]
}
